{
  "name": "php-serialize-inspector",
  "displayName": "PHP Serialize Inspector",
  "description": "Safely serialize and unserialize PHP serialized data in VS Code",
  "version": "0.2.1",
  "publisher": "USaditya98",
  "repository": {
    "type": "git",
    "url": "https://github.com/USaditya98/php-serialize-inspector"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "php-serialize-inspector.unserialize",
        "title": "PHP: Unserialize"
      },
      {
        "command": "php-serialize-inspector.serialize",
        "title": "PHP: Serialize (JSON to PHP)"
      },
      {
        "command": "php-serialize-inspector.compare",
        "title": "PHP: Compare Serialized Strings (Diff)"
      },
      {
        "command": "php-serialize-inspector.extract",
        "title": "PHP: Extract Key from Payload"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "php-serialize-inspector.unserialize",
          "group": "modification"
        },
        {
          "command": "php-serialize-inspector.serialize",
          "group": "modification"
        },
        {
          "command": "php-serialize-inspector.compare",
          "group": "modification"
        },
        {
          "command": "php-serialize-inspector.extract",
          "group": "modification"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "php-serialize-inspector",
          "title": "PHP Serialize",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "php-serialize-inspector": [
        {
          "id": "php-serialize-explorer",
          "name": "Payload Explorer"
        }
      ]
    },
    "languages": [
      {
        "id": "phpser",
        "aliases": ["PHP Serialized"],
        "extensions": [".phpser"]
      }
    ],
    "grammars": [
      {
        "language": "phpser",
        "scopeName": "source.phpser",
        "path": "./syntaxes/phpser.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "PHP Serialize Inspector",
      "properties": {
        "phpSerializeInspector.defaultFormat": {
          "type": "string",
          "enum": [
            "Ask (Dropdown)",
            "JSON (Formatted)",
            "JSON (Minified)",
            "PHP Array",
            "PHP var_export()",
            "JavaScript Object",
            "TypeScript",
            "YAML",
            "XML",
            "Pretty Tree"
          ],
          "default": "Ask (Dropdown)",
          "description": "The default format to convert PHP serialized strings into."
        },
        "phpSerializeInspector.indentSize": {
          "type": "number",
          "default": 4,
          "description": "Number of spaces to use for indentation in formatted outputs."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "jest"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^18.x",
    "@types/vscode": "^1.80.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.0.0"
  }
}
